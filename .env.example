# kuma-gate settings. Secrets go here (or in systemd's EnvironmentFile), never in the YAML.

# The admin host's public URL: Kuma's dashboard, the sign-in pages. Required.
KUMAGATE_BASE_URL=https://status.example.org

# Hosts that serve only Kuma's public paths (status pages, badges, push), comma-separated.
# Any other Host gets 404. Optional.
#KUMAGATE_STATUS_HOSTS=status.example.com,status.example.net

# Uptime Kuma, listening only on localhost or a private network, with "Disable Auth" on.
#KUMAGATE_UPSTREAM=http://127.0.0.1:3001

# The sign-in providers and the gate.admins allowlist (config.example.yaml). Required.
KUMAGATE_AUTH_CONFIG=/etc/kuma-gate/config.yaml

# Signs the session cookies: 32+ characters (openssl rand -base64 48). Changing it signs everyone out.
KUMAGATE_SECRET=
# Seals the local accounts' TOTP secrets: 32+ characters, different from KUMAGATE_SECRET.
# Losing it means resetting everyone's TOTP. Needed only with a local provider.
KUMAGATE_AUTH_KEY=

# Client id and secret of each Mastodon/OIDC provider, under the names the YAML gives.
#KUMAGATE_BOLHA_CLIENT_ID=
#KUMAGATE_BOLHA_CLIENT_SECRET=

# Where the local accounts file goes when the YAML has no users_file.
#KUMAGATE_DATA=/var/lib/kuma-gate

# Address to listen on (host:port or :port). The healthcheck follows it.
#KUMAGATE_LISTEN=127.0.0.1:3003

# Proxies whose X-Forwarded-For and X-Forwarded-Proto are believed (nginx in front).
#KUMAGATE_TRUSTED_PROXIES=127.0.0.1,::1

# Language when the browser asks for neither pt nor en; the look (gcn red, bolha yellow).
#KUMAGATE_LANG=en
#KUMAGATE_FAMILY=gcn
